# Copia este archivo a .env (no se sube a git) y completa los valores.
# En Vercel, define estas mismas variables en Settings > Environment Variables.

GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
GOOGLE_IA_API_KEY=

# Opcionales (por defecto /api y /api/v1, que usan el proxy de desarrollo).
# En producción pon la URL completa del backend, por ejemplo https://mi-backend.com/api
API_URL=/api
API_V1_URL=/api/v1
